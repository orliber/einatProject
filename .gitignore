# מידע מטופלים – לעולם לא ב-git
vault/
*.db
*.db-journal
*.db-wal
*.vaultbak
*.docx
!templates/*.docx
real_data/

# סודות
.env
*.key

# build
node_modules/
dist/
target/
__pycache__/
.venv/
*.spec

# ארכיונים וקבצים בינאריים עוקפים סריקת pre-commit – לא נכנסים לריפו
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# Tauri / frontend build output
apps/desktop/src-tauri/gen/
apps/desktop/dist/
apps/desktop/dist-preview/
apps/desktop/test-results/
apps/desktop/playwright-report/
tests/e2e/out/
sample-documents/

# Update signing keys never enter the repository (D-033)
*.pk8
*.pem
*.key
release-out/

# The OCR engine is fetched and built in CI (windows/fetch-ocr.ps1), never committed
apps/desktop/src-tauri/ocr/
# The FIPS module DLL and its installer config, made at build time (windows/bundle-fips.ps1)
apps/desktop/src-tauri/fips/
apps/desktop/src-tauri/tauri.fips.conf.json
