    "e2e": "playwright test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/assistant": "^5.3.0",
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "@radix-ui/react-context-menu": "^2.4.1",
