{
  "name": "diagnostic-vault-desktop",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:preview": "tsc --noEmit && vite build --mode preview-web",
