{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window may call only the application's own commands. No fs, shell, http or other plugins.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-ping",
    "allow-app-status",
    "allow-create-vault",
    "allow-confirm-recovery-key",
    "allow-unlock",
    "allow-unlock-with-recovery",
    "allow-lock",
    "allow-set-api-key",
    "allow-set-model",
    "allow-set-lock-minutes",
    "allow-set-practitioner",
    "allow-set-review-only-suspect",
    "allow-report-settings",
    "allow-set-report-settings",
    "allow-list-cases",
    "allow-create-case",
    "allow-update-case",
    "allow-delete-case",
    "allow-set-identities",
    "allow-case-detail",
    "allow-add-input",
    "allow-update-input",
    "allow-delete-input",
    "allow-import-document",
    "allow-preview-filter",
    "allow-decide-suspect",
    "allow-prepare-section",
    "allow-prepare-full-draft",
    "allow-send-section",
    "allow-chat",
    "allow-approve-paragraph",
    "allow-reject-paragraph",
    "allow-edit-paragraph",
    "allow-add-own-paragraph",
    "allow-prepare-consult",
    "allow-send-consult",
    "allow-check-export",
    "allow-export-report"
  ]
}
